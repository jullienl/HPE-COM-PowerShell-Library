            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>ServerHardware_NTPSource</Label></TableColumnHeader>
                    <TableColumnHeader><Label>ServerProfile_BIOSConsistency</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Storage_DisableVolumeExtraAccessCheck</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Storage_VolumeTemplateRequired</Label></TableColumnHeader>
                    <TableColumnHeader><Label>UI_RestrictReadAccess</Label></TableColumnHeader>
                </TableHeaders>
