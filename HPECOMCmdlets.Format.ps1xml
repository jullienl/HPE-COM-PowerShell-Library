                                        $Weeks = ([Math]::Round($TimeLeftBeforeStart.TotalMinutes / 10080, 1))

                                        $days_per_week = 7
                                                                                
                                        # Extract whole weeks
                                        $whole_weeks = [math]::Floor($Weeks)

