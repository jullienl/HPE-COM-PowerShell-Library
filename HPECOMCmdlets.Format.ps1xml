                        <Label>Exception</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Status</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Details</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Exception</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <View>
            <Name>COM Approval Policies</Name>
            <ViewSelectedBy>
                <TypeName>HPEGreenLake.COM.ApprovalPolicies</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>State</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Description</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>EnablePolicies</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>AssignedGroupNumber</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>state</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>description</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.policyData.approvables.Count -gt 0) {
                                        $_.policyData.approvables.Count
                                    } else {
                                        "0"
                                    }
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.policyData.resources) {
                                        $_.policyData.resources.Count
                                    } else {
                                        "0"
                                    }
                                </ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <View>
            <Name>COM Approval Policy Details</Name>
            <ViewSelectedBy>
                <TypeName>HPEGreenLake.COM.ApprovalPolicies.Details</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Operation</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Status</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Approvals</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Approvers</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>GroupName</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Operation</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Status</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Approvals</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Approvers</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>GroupName</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- COM Approval Requests Status -->
        <View>
            <Name>COM Approval Requests Status</Name>
            <ViewSelectedBy>
                <TypeName>HPEGreenLake.COM.ApprovalRequests.Status</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Id</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ApprovalState</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Status</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Details</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Exception</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Id</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>ApprovalState</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Status</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Details</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Exception</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <!-- COM Approval Requests -->
        <View>
            <Name>COM Approval Requests</Name>
            <ViewSelectedBy>
                <TypeName>HPEGreenLake.COM.ApprovalRequests</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>ApprovableName</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ApprovalState</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>RequesterEmail</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>CreatedAt</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>MinApprovers</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>RequestRemarks</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>approvableName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>approvalState</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>"{0}" -f $_.requester.email</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($_.createdAt) { [datetime]$_.createdAt }</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>minApprovers</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>requestRemarks</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>


        <View>
            <Name>Firmware Download Report</Name>
            <ViewSelectedBy>
                <TypeName>HPEGreenLake.COM.Servers.FirmwareDownloadReport</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Server</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>SerialNumber</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Model</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Status</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>AttemptedAt</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Duration</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Baseline</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>InstallDrivers</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Downgrade</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Region</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>serverName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>serialNumber</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>model</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>status</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($_.attemptedAt) { [datetime]$_.attemptedAt }</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>duration</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>baselineReleaseVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>installSwDrivers</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>downgrade</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>region</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

        <View>
            <Name>Firmware Download Report Components</Name>
            <ViewSelectedBy>
                <TypeName>HPEGreenLake.COM.Servers.FirmwareDownloadReport.Components</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Server</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>SerialNumber</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>AttemptedAt</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Baseline</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ComponentName</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ComponentVersion</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ComponentStatus</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>OverallStatus</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>serverName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>serialNumber</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($_.attemptedAt) { [datetime]$_.attemptedAt }</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>baselineReleaseVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>componentName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>componentVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>componentStatus</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>overallStatus</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

    </ViewDefinitions>
</Configuration>




