                            <TableColumnItem><ScriptBlock>$_.configuration.marketingOptIn</ScriptBlock></TableColumnItem>
                            <TableColumnItem><ScriptBlock>$_.configuration.autoEnableDevices</ScriptBlock></TableColumnItem>
