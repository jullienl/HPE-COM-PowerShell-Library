                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Type</Label>
                        <!-- <Width>30</Width> -->
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>SubscriptionKey</Label>
                        <!-- <Width>30</Width> -->
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ApplianceName</Label>
                        <!-- <Width>30</Width> -->
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>CreatedAt</Label>
                        <!-- <Width>30</Width> -->
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ExpiresAt</Label>
                        <!-- <Width>30</Width> -->
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>COMInstance</Label>
                        <!-- <Width>30</Width> -->
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>activationKey</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.applianceName -eq $null) {
                                        "Direct" 
                                    } else {
                                        "Secure Gateway"
                                    }
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>subscriptionKey</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>applianceName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.createdAt) { ([datetime]$_.createdAt).ToString("MM/dd/yyyy HH:mm:ss") } else { "" }
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.expiresAt) { ([datetime]$_.expiresAt).ToString("MM/dd/yyyy HH:mm:ss") } else { "" }
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>region</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

