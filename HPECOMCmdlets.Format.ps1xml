                                        "Enabled"
                                    }
                                    else {
                                        "Disabled"
                                    }
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.autoAddTags -replace '^@{', '' -replace '}$', ''</ScriptBlock>
