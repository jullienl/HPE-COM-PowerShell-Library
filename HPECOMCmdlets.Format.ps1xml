        <View>
            <Name>Groups Hardware Verification</Name>
            <ViewSelectedBy>
                <TypeName>HPEGreenLake.COM.Groups.HardwareVerification</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Server</Label></TableColumnHeader>
                    <TableColumnHeader><Label>SerialNumber</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Group</Label></TableColumnHeader>
                    <TableColumnHeader><Label>HardwareVerification</Label></TableColumnHeader>
                    <TableColumnHeader><Label>ComponentsChanged</Label></TableColumnHeader>
                    <TableColumnHeader><Label>BaselineAcceptedAt</Label></TableColumnHeader>
                    <TableColumnHeader><Label>BaselineAcceptedBy</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>serverName</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>serialNumber</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>groupName</PropertyName></TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    switch ($_.secureHardwareStatus) {
                                        'OK'          { 'Verified' }
                                        'RISK'        { 'Failed' }
                                        'NOT_ENABLED' { 'Disabled' }
                                        default       { $_.secureHardwareStatus }
                                    }
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.componentsChanged -join ', '</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($_.baselineLastAcceptedAt) { [datetime]$_.baselineLastAcceptedAt }</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem><PropertyName>baselineAcceptedBy</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>

